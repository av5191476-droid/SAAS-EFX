{
  "name": "efx",
  "private": true,
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@efx/nextjs",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "cd packages/db && bun run db:generate",
    "db:push": "cd packages/db && bun run db:push",
    "db:seed": "cd packages/db && bun run seed",
    "db:studio": "cd packages/db && bunx prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "printWidth": 110,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
